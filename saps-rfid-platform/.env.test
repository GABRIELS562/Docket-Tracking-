# Test Environment Configuration
NODE_ENV=test
PORT=8081

# Test Database
DB_HOST=localhost
DB_PORT=5433
DB_NAME=saps_rfid_test
DB_USER=testuser
DB_PASSWORD=testpass
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_SSL_ENABLED=false

# Test Redis
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=testpass

# Mock RFID
RFID_READER_IPS=127.0.0.1
RFID_READER_PORT=5084
DEV_MOCK_RFID_ENABLED=true

# Logging
LOG_LEVEL=error
LOG_FILE=./logs/test.log
LOG_JSON=true

# Disable external services
METRICS_ENABLED=false
WEBSOCKET_ENABLED=true

# Fast timeouts for tests
RFID_RECONNECT_DELAY=100
RFID_CONNECTION_TIMEOUT=1000
