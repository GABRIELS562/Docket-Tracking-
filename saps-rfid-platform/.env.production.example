# ==============================================================================
# SAPS RFID Platform - Production Environment Configuration
# ==============================================================================
# IMPORTANT: Copy this file to .env.production and update ALL values
# NEVER commit .env.production to version control
# All secrets should use strong, randomly generated values
# ==============================================================================

# ==============================================================================
# Application Configuration
# ==============================================================================
NODE_ENV=production
PORT=8080
APP_NAME=saps-rfid-platform
APP_VERSION=1.0.0

# Domain configuration (for CORS, cookies, SSL)
DOMAIN=rfid.example.com

# ==============================================================================
# Database - PostgreSQL with TimescaleDB
# ==============================================================================
# REQUIRED: Generate a strong password (min 32 characters)
# Example: openssl rand -base64 32
DB_HOST=timescaledb
DB_PORT=5432
DB_NAME=saps_rfid
DB_USER=saps_prod_user
DB_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD_MIN_32_CHARS

# Connection pool settings (tune based on expected load)
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000

# SSL configuration (recommended for production)
DB_SSL_ENABLED=true
DB_SSL_CA_PATH=/app/config/ssl/ca-certificate.crt

# PostgreSQL performance tuning
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
POSTGRES_WORK_MEM=64MB
POSTGRES_MAINTENANCE_WORK_MEM=128MB

# ==============================================================================
# Redis Cache
# ==============================================================================
# REQUIRED: Generate a strong password
# Example: openssl rand -base64 32
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_GENERATE_STRONG_REDIS_PASSWORD
REDIS_DB=0
REDIS_KEY_PREFIX=saps:prod:
REDIS_MAX_MEMORY=512mb

# ==============================================================================
# JWT Authentication
# ==============================================================================
# REQUIRED: Generate a strong secret key (min 64 characters)
# Example: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_STRONG_JWT_SECRET_MIN_64_CHARS
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ==============================================================================
# RFID Readers Configuration
# ==============================================================================
# Comma-separated list of production RFID reader IP addresses
RFID_READER_IPS=192.168.10.100,192.168.10.101,192.168.10.102
RFID_READER_PORT=5084
RFID_RECONNECT_DELAY=5000
RFID_CONNECTION_TIMEOUT=10000
RFID_TAG_DEDUP_WINDOW=3000
RFID_MAX_RECONNECT_ATTEMPTS=10
RFID_HEALTH_CHECK_INTERVAL=30000

# LLRP Protocol Settings
RFID_TRANSMIT_POWER=31.5
RFID_ANTENNA_PORTS=1,2,3,4
RFID_SESSION=1
RFID_MODE_INDEX=1002

# ==============================================================================
# Logging
# ==============================================================================
LOG_LEVEL=info
LOG_FILE=/app/logs/app.log
LOG_MAX_SIZE=50m
LOG_MAX_FILES=14
LOG_DATE_PATTERN=YYYY-MM-DD
LOG_COLORIZE=false
LOG_JSON=true

# ==============================================================================
# Security
# ==============================================================================
# CORS - comma-separated allowed origins
# REQUIRED: Update with your actual production domains
CORS_ORIGIN=https://rfid.example.com,https://www.rfid.example.com
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Security Headers (Helmet)
HELMET_ENABLED=true
HELMET_CSP_ENABLED=true

# ==============================================================================
# WebSocket Configuration
# ==============================================================================
WEBSOCKET_ENABLED=true
WEBSOCKET_PATH=/socket.io
WEBSOCKET_PING_TIMEOUT=60000
WEBSOCKET_PING_INTERVAL=25000

# ==============================================================================
# Metrics & Monitoring
# ==============================================================================
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics

# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_DETAILED_PATH=/health/detailed

# Prometheus
PROMETHEUS_RETENTION=30d
PROMETHEUS_RETENTION_SIZE=10GB

# ==============================================================================
# Grafana
# ==============================================================================
# REQUIRED: Change default admin credentials
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_STRONG_GRAFANA_PASSWORD
GRAFANA_ROOT_URL=https://grafana.rfid.example.com

# ==============================================================================
# Multi-Tenant Configuration
# ==============================================================================
DEFAULT_TENANT_ID=default

# ==============================================================================
# Domain Configuration
# ==============================================================================
# Lab Number Format: FSL-YYYY-NNNNNN
LAB_NUMBER_PREFIX=FSL
LAB_NUMBER_YEAR_LENGTH=4
LAB_NUMBER_SEQUENCE_LENGTH=6

# Zone Configuration
MAX_ZONE_CAPACITY=500
ZONE_OCCUPANCY_WARNING_THRESHOLD=0.8

# Location Confidence Thresholds
LOCATION_CONFIDENCE_HIGH=0.8
LOCATION_CONFIDENCE_MEDIUM=0.5

# ==============================================================================
# Data Storage Paths
# ==============================================================================
# Base path for persistent data (must exist and be writable)
DATA_PATH=/var/lib/saps-rfid

# ==============================================================================
# Backup Configuration
# ==============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=saps-rfid-backups
BACKUP_S3_REGION=af-south-1

# ==============================================================================
# SSL/TLS Configuration (for Nginx)
# ==============================================================================
SSL_CERTIFICATE_PATH=/etc/nginx/ssl/fullchain.pem
SSL_CERTIFICATE_KEY_PATH=/etc/nginx/ssl/privkey.pem
SSL_DHPARAM_PATH=/etc/nginx/ssl/dhparam.pem

# ==============================================================================
# Email Notifications (Optional)
# ==============================================================================
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=SAPS RFID Platform <no-reply@example.com>
ALERT_EMAIL_RECIPIENTS=admin@example.com,ops@example.com

# ==============================================================================
# External Integrations (Optional)
# ==============================================================================
# Sentry Error Tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# New Relic APM
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=saps-rfid-platform-prod

# ==============================================================================
# Feature Flags
# ==============================================================================
FEATURE_AUDIT_LOGGING=true
FEATURE_REAL_TIME_ANALYTICS=true
FEATURE_CHAIN_OF_CUSTODY=true
FEATURE_3D_VISUALIZATION=true
