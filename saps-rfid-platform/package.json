{
  "name": "saps-rfid-platform",
  "version": "1.0.0",
  "description": "Enterprise-grade RFID tracking backend system for forensic laboratory evidence management",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:pm2": "pm2 start ecosystem.config.js",
    "stop:pm2": "pm2 stop saps-rfid-platform",
    "restart:pm2": "pm2 restart saps-rfid-platform",
    "logs:pm2": "pm2 logs saps-rfid-platform",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:e2e": "jest --testPathPattern=tests/e2e",
    "test:ci": "jest --coverage --ci --maxWorkers=2",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src/ --ext .ts",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=false eslint src/ --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node -r tsx/cjs scripts/migrate.ts",
    "db:seed": "node -r tsx/cjs scripts/seed.ts",
    "db:reset": "node -r tsx/cjs scripts/reset.ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:build": "docker build -t saps-rfid-platform .",
    "clean": "rm -rf dist coverage .turbo node_modules/.cache",
    "prepare": "husky install",
    "precommit": "lint-staged"
  },
  "keywords": [
    "rfid",
    "tracking",
    "forensics",
    "evidence-management",
    "llrp",
    "timescaledb",
    "clean-architecture"
  ],
  "author": "SAPS Forensic Laboratory",
  "license": "PROPRIETARY",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/bcrypt": "^6.0.0",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "compression": "1.7.4",
    "cors": "2.8.5",
    "date-fns": "3.6.0",
    "dotenv": "16.4.5",
    "express": "4.18.3",
    "express-async-errors": "3.1.1",
    "express-rate-limit": "7.2.0",
    "helmet": "7.1.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "llrp": "0.0.1",
    "morgan": "1.10.0",
    "neverthrow": "6.1.0",
    "pg": "8.11.3",
    "prom-client": "15.1.2",
    "reflect-metadata": "0.2.2",
    "socket.io": "4.6.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tsyringe": "4.8.0",
    "uuid": "9.0.1",
    "winston": "3.13.0",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@types/compression": "1.7.5",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jest": "30.0.0",
    "@types/morgan": "1.9.9",
    "@types/node": "20.12.7",
    "@types/pg": "8.11.5",
    "@types/supertest": "6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "9.0.8",
    "@typescript-eslint/eslint-plugin": "7.7.0",
    "@typescript-eslint/parser": "7.7.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-jest": "28.2.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "5.1.3",
    "husky": "9.0.11",
    "jest": "30.4.2",
    "lint-staged": "15.2.2",
    "pm2": "5.3.1",
    "prettier": "3.2.5",
    "supertest": "7.0.0",
    "ts-jest": "29.4.11",
    "ts-node": "10.9.2",
    "tsx": "4.7.2",
    "typescript": "5.4.5"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "semver@<7.5.2": ">=7.5.2"
    }
  }
}
