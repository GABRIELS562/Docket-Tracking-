# ==============================================================================
# SAPS RFID Platform - Environment Configuration
# ==============================================================================
# Copy this file to .env and update with your actual values
# NEVER commit .env file to version control
# ==============================================================================

# ==============================================================================
# Application
# ==============================================================================
NODE_ENV=development
PORT=8080
APP_NAME=saps-rfid-platform
APP_VERSION=1.0.0

# ==============================================================================
# Database - PostgreSQL with TimescaleDB
# ==============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=saps_rfid
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_SSL_ENABLED=false

# ==============================================================================
# Redis Cache (Optional)
# ==============================================================================
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123
REDIS_DB=0
REDIS_KEY_PREFIX=saps:

# ==============================================================================
# RFID Readers Configuration
# ==============================================================================
# Comma-separated list of reader IP addresses
RFID_READER_IPS=192.168.1.100,192.168.1.101,192.168.1.102
RFID_READER_PORT=5084
RFID_RECONNECT_DELAY=5000
RFID_CONNECTION_TIMEOUT=10000
RFID_TAG_DEDUP_WINDOW=3000
RFID_MAX_RECONNECT_ATTEMPTS=10
RFID_HEALTH_CHECK_INTERVAL=30000

# LLRP Protocol Settings
RFID_TRANSMIT_POWER=31.5
RFID_ANTENNA_PORTS=1,2,3,4
RFID_SESSION=1
RFID_MODE_INDEX=1002

# ==============================================================================
# Logging
# ==============================================================================
LOG_LEVEL=info
LOG_FILE=./logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=7
LOG_DATE_PATTERN=YYYY-MM-DD
LOG_COLORIZE=true
LOG_JSON=false

# ==============================================================================
# Security
# ==============================================================================
# Comma-separated allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Security Headers (Helmet)
HELMET_ENABLED=true
HELMET_CSP_ENABLED=true

# ==============================================================================
# WebSocket
# ==============================================================================
WEBSOCKET_ENABLED=true
WEBSOCKET_PATH=/socket.io
WEBSOCKET_PING_TIMEOUT=60000
WEBSOCKET_PING_INTERVAL=25000

# ==============================================================================
# Metrics & Monitoring
# ==============================================================================
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics

# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_DETAILED_PATH=/health/detailed

# ==============================================================================
# Domain Configuration
# ==============================================================================
# Lab Number Format: FSL-YYYY-NNNNNN
LAB_NUMBER_PREFIX=FSL
LAB_NUMBER_YEAR_LENGTH=4
LAB_NUMBER_SEQUENCE_LENGTH=6

# Zone Configuration
MAX_ZONE_CAPACITY=500
ZONE_OCCUPANCY_WARNING_THRESHOLD=0.8

# Location Confidence Thresholds
LOCATION_CONFIDENCE_HIGH=0.8
LOCATION_CONFIDENCE_MEDIUM=0.5

# ==============================================================================
# PM2 Configuration
# ==============================================================================
PM2_INSTANCES=2
PM2_MAX_MEMORY_RESTART=1G
PM2_LOG_DATE_FORMAT=YYYY-MM-DD HH:mm:ss Z

# ==============================================================================
# Testing
# ==============================================================================
TEST_DB_HOST=localhost
TEST_DB_PORT=5433
TEST_DB_NAME=saps_rfid_test
TEST_DB_USER=testuser
TEST_DB_PASSWORD=testpass
TEST_REDIS_HOST=localhost
TEST_REDIS_PORT=6380
TEST_REDIS_PASSWORD=testpass

# ==============================================================================
# Development Tools
# ==============================================================================
# Mock RFID readers for development
DEV_MOCK_RFID_ENABLED=false
DEV_MOCK_TAG_INTERVAL=5000

# Database seeding
DEV_AUTO_SEED=false
